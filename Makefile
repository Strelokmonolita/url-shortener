.PHONY: install run lint format typecheck test check up down logs migrate revision

install: ## Install the project with dev dependencies
	uv sync --frozen --extra dev

run: ## Run the local API (DEBUG=true enables live reload)
	uv run --frozen python -m app

lint: ## Run ruff
	uv run --frozen --extra dev ruff check .
	uv run --frozen --extra dev ruff format --check .

format: ## Auto-fix lint issues and format code
	uv run --frozen --extra dev ruff check --fix .
	uv run --frozen --extra dev ruff format .

typecheck: ## Run mypy in strict mode
	uv run --frozen --extra dev mypy app tests

test: ## Run the test suite
	uv run --frozen --extra dev pytest

check: lint typecheck test ## Run every quality gate

up: ## Build and start the stack (does not apply migrations)
	docker compose up --build -d

down: ## Stop the stack without deleting the database volume
	docker compose down

logs: ## Follow container logs
	docker compose logs -f api

migrate: ## Apply migrations inside the running api container
	docker compose exec api alembic upgrade head

revision: ## Create an autogenerated migration (make revision m="message")
	uv run --frozen alembic revision --autogenerate -m "$(m)"
