# Application
APP_NAME=URL Shortener
ENVIRONMENT=local
# DEBUG=true is allowed only in local/test, not in staging/production.
DEBUG=false

# Server
# Compose always binds the API to 0.0.0.0:8000 inside the container.
# PORT controls the published host port; keep BASE_URL in sync with it.
HOST=0.0.0.0
PORT=8000
# Public base URL used to build short links returned by the API.
BASE_URL=http://localhost:8000

# PostgreSQL connection for a locally running API.
# Compose overrides the API's connection host/port to db:5432 internally.
# POSTGRES_PORT controls the database port published on localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener
POSTGRES_DB=shortener

# JWT — the placeholder is allowed only in local/test.
# Staging/production require at least 32/48/64 key bytes for HS256/HS384/HS512.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Link generation
SHORT_CODE_LENGTH=7
MAX_CUSTOM_ALIAS_LENGTH=32
