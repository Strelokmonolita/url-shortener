# Application
APP_NAME=URL Shortener
ENVIRONMENT=local
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
# Public base URL used to build short links returned by the API.
BASE_URL=http://localhost:8000

# PostgreSQL (values here match the docker-compose service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener
POSTGRES_DB=shortener

# JWT — replace SECRET_KEY with a long random string in any real deployment
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Link generation
SHORT_CODE_LENGTH=7
MAX_CUSTOM_ALIAS_LENGTH=32
